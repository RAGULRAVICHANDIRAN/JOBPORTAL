# ===========================
# JobPilot AI — Environment
# ===========================

# App
APP_NAME=JobPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./jobpilot.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jobpilot

# Redis (optional, for production)
# REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider (openai | gemini | mock)
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (smtp | sendgrid | mock)
EMAIL_PROVIDER=mock
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=

# Push Notifications
# PUSH_NOTIFICATION_KEY=

# Rate Limits
RATE_LIMIT_PER_MINUTE=60
MAX_APPLICATIONS_PER_DAY=30

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Locale
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
